generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Brand {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  logoUrl    String?   @map("logo_url") @db.VarChar(500)
  country    String?   @db.VarChar(100)
  website    String?   @db.VarChar(500)
  reputation String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  products   Product[]

  @@index([deletedAt])
  @@map("brands")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  iconUrl     String?   @map("icon_url") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id            Int                 @id @default(autoincrement())
  name          String              @db.VarChar(255)
  brandId       Int                 @map("brand_id")
  categoryId    Int?                @map("category_id")
  description   String?             @db.Text
  price         Int?
  imageUrl      String?             @map("image_url") @db.VarChar(500)
  imagePublicId String?             @map("image_public_id") @db.VarChar(255)
  bpom          String?             @db.VarChar(100)
  size          String?             @db.VarChar(50)
  halal         Boolean?
  rating        Float?
  reviewCount   Int?                @map("review_count")
  howToUse      String?             @map("how_to_use") @db.Text
  notes         String?             @db.Text
  skinTypes     Json?               @map("skin_types")
  concerns      Json?
  buyLink       String?             @map("buy_link") @db.VarChar(500) // <-- TAMBAHKAN BARIS INI
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")
  ingredients   ProductIngredient[]
  brand         Brand               @relation(fields: [brandId], references: [id])
  category      Category?           @relation(fields: [categoryId], references: [id])
  routines    Routine[]

  @@unique([name, brandId])
  @@index([deletedAt])
  @@index([brandId])
  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model Ingredient {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique @db.VarChar(255)
  function           String?             @db.Text
  description        String?             @db.Text
  suitableSkin       Json?               @map("suitable_skin")
  concerns           Json?
  photoUrl           String?             @map("photo_url") @db.VarChar(500)
  sourceLink         String?             @map("source_link") @db.VarChar(500)
  catalogId          Int?                @map("catalog_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  catalog            IngredientCatalog?  @relation(fields: [catalogId], references: [id])
  productIngredients ProductIngredient[]

  @@index([catalogId], map: "ingredients_catalog_id_fkey")
  @@map("ingredients")
}

model IngredientCatalog {
  id               Int          @id @default(autoincrement())
  name             String       @unique @db.VarChar(255)
  photoUrl         String?      @map("photo_url") @db.VarChar(500)
  description      String?      @db.Text
  sourceLink       String?      @map("source_link") @db.VarChar(500)
  commonUses       Json?        @map("common_uses")
  allergyPotential String?      @map("allergy_potential") @db.Text
  skinTypeSummary  String?      @map("skin_type_summary") @db.Text
  riskBenefit      String?      @map("risk_benefit") @db.Text
  category         String?      @db.VarChar(100)
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  ingredients      Ingredient[]

  @@map("ingredient_catalog")
}

model ProductIngredient {
  productId    Int        @map("product_id")
  ingredientId Int        @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@index([ingredientId], map: "product_ingredients_ingredient_id_fkey")
  @@map("product_ingredients")
}

model User {
  id          Int           @id @default(autoincrement())
  firebaseUid String        @unique
  email       String        @unique
  name        String?
  photoUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // TAMBAHKAN DUA BARIS INI:
  routines    Routine[]
  skinProfile SkinProfile?
}

model Routine {
     id        Int      @id @default(autoincrement())
     userId    Int
     user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
     productId Int      
     product   Product  @relation(fields: [productId], references: [id]) // <-- PASTIKAN BARIS INI ADA
     slotId    String   
     timeOfDay String   
     step      Int      
     createdAt DateTime @default(now())

     @@unique([userId, slotId, timeOfDay]) 
}

model SkinProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinType    String
  concerns    Json
  answers     Json?
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}